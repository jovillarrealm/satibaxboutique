{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satibax-boutique",
  "compatibility_date": "2026-10-01",
  "pages_build_output_dir": "dist",

  /**
   * D1 Database Binding & R2 Bucket Binding
   * In Cloudflare Pages, configure bindings directly in the dashboard under:
   * Settings > Functions > D1 Database Bindings (Variable name: DB)
   * Settings > Functions > R2 Bucket Bindings (Variable name: MEDIA_BUCKET)
   *
   * Or uncomment below and provide your real D1 database UUID:
   * "d1_databases": [
   *   {
   *     "binding": "DB",
   *     "database_name": "satibax-db",
   *     "database_id": "<YOUR-REAL-D1-DATABASE-UUID>",
   *     "migrations_dir": "migrations"
   *   }
   * ]
   */

  /**
   * Compatibility flags for optimal edge performance & Web standard APIs
   */
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
